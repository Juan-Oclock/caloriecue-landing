# Server-side only. Never expose these values through NEXT_PUBLIC_* variables.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Macro cheat sheet rate-limit hashing and Resend idempotency. Generate at
# least 32 random bytes (for example: `openssl rand -base64 32`) and set a
# stable, environment-specific value in local, Preview, and Production.
MACRO_CHEAT_SHEET_RATE_LIMIT_SECRET=
