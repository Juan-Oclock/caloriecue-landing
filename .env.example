# Server-side only. Never expose these values through NEXT_PUBLIC_* variables.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Preferred modern Supabase backend credential. A legacy
# SUPABASE_SERVICE_ROLE_KEY remains supported during migration.
SUPABASE_SECRET_KEY=

# Macro cheat sheet rate-limit hashing and Resend idempotency. Generate at
# least 32 random bytes (for example: `openssl rand -base64 32`). Production
# requires it. Set it in non-production only when that environment uses its own
# matching non-production Supabase URL and backend credentials.
MACRO_CHEAT_SHEET_RATE_LIMIT_SECRET=
